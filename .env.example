# docker-compose가 읽는 환경변수 템플릿.
# 실제 값은 이 파일을 .env로 복사해서 채운다. (.env는 git에 올라가지 않음)

# --- DB (Tier 1: RDS MySQL) ---
# DB_HOST = RDS 엔드포인트. `terraform output rds_endpoint`로 확인.
# 로컬 개발(docker-compose.yml)에서는 컨테이너 이름이라 DB_HOST=mysql.
DB_HOST=your-rds-endpoint.ap-northeast-2.rds.amazonaws.com
DB_NAME=team05_db
DB_USERNAME=drawrace
DB_PASSWORD=change_me
# DB_ROOT_PASSWORD: 로컬 docker-compose.yml의 mysql 컨테이너에만 필요.
# 운영(docker-compose.prod.yml)은 RDS를 쓰므로 불필요.
DB_ROOT_PASSWORD=change_me_root

# --- Redis (Tier 1: ElastiCache) ---
# REDIS_HOST = ElastiCache 엔드포인트. `terraform output redis_endpoint`로 확인.
# 로컬 개발에서는 REDIS_HOST=redis.
REDIS_HOST=your-redis-endpoint.apn2.cache.amazonaws.com

# --- JWT ---
# 최소 32바이트 이상 권장
JWT_SECRET_KEY=change_me_to_a_random_32_byte_or_longer_secret

# --- 스토리지 (local 모드: 업로드 파일 URL 베이스) ---
STORAGE_LOCAL_BASE_URL=http://your-domain-or-ip:8080/files/uploads

# --- AI 게이트웨이 (기본 quickdraw 모드면 비워둬도 됨) ---
AI_MODE=quickdraw
AI_GATEWAY_BASE_URL=
AI_GATEWAY_API_KEY=
AI_MODEL=
